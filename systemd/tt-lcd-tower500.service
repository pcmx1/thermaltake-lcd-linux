[Unit]
Description=Thermaltake Tower 500 bar LCD temperature monitor (264a:233d)
After=default.target
StartLimitIntervalSec=0

[Service]
ExecStart=/usr/bin/python3 /home/sean/thermaltake-lcd-linux/tt-lcd-tower500.py
