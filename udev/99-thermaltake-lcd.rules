# Thermaltake LCD controllers — grant rw access to the plugdev group
# Install: sudo cp 99-thermaltake-lcd.rules /etc/udev/rules.d/
#          sudo udevadm control --reload-rules && sudo udevadm trigger

# RC Pro 3.9" / Bar TFT LCD (264a:232a, 264a:233d)
SUBSYSTEM=="usb",    ATTRS{idVendor}=="264a", ATTRS{idProduct}=="232a", MODE="0660", GROUP="plugdev", TAG+="uaccess"
SUBSYSTEM=="hidraw", ATTRS{idVendor}=="264a", ATTRS{idProduct}=="232a", MODE="0660", GROUP="plugdev", TAG+="uaccess"
SUBSYSTEM=="usb",    ATTRS{idVendor}=="264a", ATTRS{idProduct}=="233d", MODE="0660", GROUP="plugdev", TAG+="uaccess"
SUBSYSTEM=="hidraw", ATTRS{idVendor}=="264a", ATTRS{idProduct}=="233d", MODE="0660", GROUP="plugdev", TAG+="uaccess"

# AIO cooler LCD / Round TFT LCD (264a:2328, 264a:233c)
SUBSYSTEM=="usb",    ATTRS{idVendor}=="264a", ATTRS{idProduct}=="2328", MODE="0660", GROUP="plugdev", TAG+="uaccess"
SUBSYSTEM=="hidraw", ATTRS{idVendor}=="264a", ATTRS{idProduct}=="2328", MODE="0660", GROUP="plugdev", TAG+="uaccess"
SUBSYSTEM=="usb",    ATTRS{idVendor}=="264a", ATTRS{idProduct}=="233c", MODE="0660", GROUP="plugdev", TAG+="uaccess"
SUBSYSTEM=="hidraw", ATTRS{idVendor}=="264a", ATTRS{idProduct}=="233c", MODE="0660", GROUP="plugdev", TAG+="uaccess"
